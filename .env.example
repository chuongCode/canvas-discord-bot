# ---------------------------------------------------------------------------
# Canvas LMS
# ---------------------------------------------------------------------------
# Root URL of your Canvas instance (no trailing /api/v1)
CANVAS_BASE_URL=https://yourschool.instructure.com
# Canvas personal access token (Account -> Settings -> New Access Token)
CANVAS_API_TOKEN=

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Right-click the target channel -> Copy Channel ID (needs Developer Mode)
DISCORD_CHANNEL_ID=
# Optional: guild (server) ID used for instant slash-command registration.
# If unset, it is derived from DISCORD_CHANNEL_ID at startup.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Behaviour (all optional — defaults shown)
# ---------------------------------------------------------------------------
# IANA timezone used for human-readable output only. Storage/compare is UTC.
TIMEZONE=America/Chicago

# ---------------------------------------------------------------------------
# Database (required) — PostgreSQL only
# ---------------------------------------------------------------------------
# Reminder history lives here. On a host with an ephemeral filesystem (Render
# free web services included) this MUST point at a managed PostgreSQL instance,
# otherwise every redeploy forgets what was already sent.
#
#   Render: paste the "Internal Database URL" from your Render PostgreSQL
#           instance. Never commit the real value.
#   Local:  docker compose up -d db   then use the URL below.
DATABASE_URL=postgresql://phat:phat@localhost:5432/phat

# How often to pull fresh state from Canvas (seconds).
CANVAS_SYNC_INTERVAL_SECONDS=300
# How often to evaluate locally cached deadlines (seconds).
REMINDER_INTERVAL_SECONDS=45

# Comma-separated reminder thresholds, in minutes before the due date.
REMINDER_THRESHOLDS_MINUTES=720,300,120,60,30,15,10,5,1

# Only track assignments due within this many days from now.
MONITOR_LOOKAHEAD_DAYS=30
# Keep recently past-due assignments cached this long (hours). No reminders.
MONITOR_PAST_GRACE_HOURS=24

# Only consider courses where you are enrolled as a student.
CANVAS_STUDENT_ENROLLMENTS_ONLY=true

# Suppress (record but do not deliver) reminders on the very first run against
# an empty database, so a fresh install does not burst-notify.
SUPPRESS_REMINDERS_ON_FIRST_RUN=false

# ---------------------------------------------------------------------------
# HTTP health server
# ---------------------------------------------------------------------------
# Render injects PORT automatically — do NOT set it in the Render dashboard.
# Locally it defaults to 8080; GET http://localhost:8080/health
PORT=8080
# Interface to bind. 0.0.0.0 is required on Render.
HTTP_HOST=0.0.0.0

LOG_LEVEL=INFO
